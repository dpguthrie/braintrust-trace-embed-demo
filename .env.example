# Braintrust Configuration
# Copy this file to .env and fill in your values

# Your Braintrust instance URL (e.g., https://www.braintrust.dev)
VITE_BRAINTRUST_URL=https://www.braintrust.dev

# Your organization name or slug
VITE_BRAINTRUST_ORG=

# Your project name (used to resolve its Braintrust project ID)
VITE_BRAINTRUST_PROJECT=

# Your Braintrust API key (starts with sk_)
VITE_BRAINTRUST_API_KEY=
