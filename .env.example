# Braintrust Configuration
# Copy this file to .env and fill in your values

# Your Braintrust instance URL (e.g., https://www.braintrust.dev)
VITE_BRAINTRUST_URL=https://www.braintrust.dev

# Optional preferred organization when the key can access more than one
VITE_BRAINTRUST_ORG=

# Your Braintrust API key (starts with sk_). This is the only required credential.
VITE_BRAINTRUST_API_KEY=
